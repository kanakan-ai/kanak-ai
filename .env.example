# Kanak AI — Local Development Environment Configuration
# Copy this file to .env and adjust values as needed

# Node environment
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=kanak
POSTGRES_USER=kanak
POSTGRES_PASSWORD=kanak_dev_password
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API Service
API_PORT=8080

# Auth configuration
# Options: mock (accepts OTP 000000, never sends real email/SMS — CI/local default)
#        | live (real delivery via the providers configured below)
AUTH_MODE=mock

# Session secret (change in production!)
SESSION_SECRET=dev_session_secret_change_in_production

# Comma-separated emails that get role=admin on first sign-in (for the local ops dashboard).
# Never grant to normal customers. Local/dev default seeds one admin so the ops dashboard
# and integration tests are reachable out of the box (AUTH_MODE=mock, OTP 000000);
# set to a real allowlist (or leave empty) outside local dev.
ADMIN_EMAILS=admin@example.com

# Web App
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/v1

# Email provider (M2-T1). Ignored while AUTH_MODE=mock — mock mode always logs to
# console instead of sending, regardless of this setting.
# Options: console (log only) | ses (AWS SES — requires AUTH_MODE=live)
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=ses: must be a verified sender identity in your SES account.
SES_FROM_EMAIL=
# Standard AWS SDK credentials — used by SES (and later SNS). New AWS accounts start in
# SES/SNS "sandbox" mode: you can only send to verified recipient addresses/numbers until
# you request production access. Leave all three blank to use an IAM role instead
# (e.g. when this actually runs on ECS/EC2/EKS — no code or config change needed there).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only set this if AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above are temporary
# credentials from `aws sts assume-role` (recommended over a long-lived IAM user key).
AWS_SESSION_TOKEN=

# SMS provider (for real phone OTP, M2-T2 — not yet implemented).
# Will reuse the AWS credentials above (AWS SNS).
# SMS_PROVIDER=console

# Optional: Apple Sign In (for production)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Optional: AI parsing (M2+)
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
