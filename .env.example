# Kanak AI — Local Development Environment Configuration
# Copy this file to .env and adjust values as needed

# Node environment
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=kanak
POSTGRES_USER=kanak
POSTGRES_PASSWORD=kanak_dev_password
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API Service
API_PORT=8080

# Auth configuration
# Options: mock (accepts OTP 000000) | real (requires SMS/email providers)
AUTH_MODE=mock

# Session secret (change in production!)
SESSION_SECRET=dev_session_secret_change_in_production

# Comma-separated emails that get role=admin on first sign-in (for the local ops dashboard).
# Never grant to normal customers. Local/dev default seeds one admin so the ops dashboard
# and integration tests are reachable out of the box (AUTH_MODE=mock, OTP 000000);
# set to a real allowlist (or leave empty) outside local dev.
ADMIN_EMAILS=admin@example.com

# Web App
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/v1

# Optional: Email provider (for real email OTP/magic links)
# EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Optional: SMS provider (for real phone OTP)
# SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Optional: Apple Sign In (for production)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Optional: AI parsing (M2+)
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
